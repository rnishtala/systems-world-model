{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "swm-rcaeval-confirm-v1",
    "namespace": "systems-world-model-lab"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 1800,
    "template": {
      "metadata": {
        "labels": {
          "swm-role": "rcaeval-offline"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "nodeSelector": {
          "kubernetes.io/hostname": "amd-halo"
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "experiment",
            "image": "python:3.11-slim",
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "1",
                "memory": "3Gi"
              },
              "limits": {
                "cpu": "2",
                "memory": "4Gi"
              }
            },
            "env": [
              {
                "name": "PYTHONUNBUFFERED",
                "value": "1"
              },
              {
                "name": "PYTHONDONTWRITEBYTECODE",
                "value": "1"
              },
              {
                "name": "OMP_NUM_THREADS",
                "value": "1"
              },
              {
                "name": "OPENBLAS_NUM_THREADS",
                "value": "1"
              },
              {
                "name": "XLA_FLAGS",
                "value": "--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1"
              },
              {
                "name": "XDG_CACHE_HOME",
                "value": "/tmp/cache"
              }
            ],
            "command": [
              "sh",
              "-ec",
              "cd /results/rcaeval-confirm-v1\nexport PYTHONPATH=/results/rcaeval-confirm-v1:/results/work/upstream\nexport DREAMER_SOURCE=/results/work/upstream\nfor seed in 42 43; do\n/results/venv/bin/python -m benchmark.dreamer --data blind --train-answers train-answers.json --out model-$seed --steps 32000 --seed $seed --diagnosis-supervision\n/results/venv/bin/python -m benchmark.confirmation --root model-$seed --data blind --answers train-answers.json --out readout-$seed\n/results/venv/bin/python -m benchmark.supervised_baseline --root model-$seed --data blind --train-answers train-answers.json --out baseline-$seed --seed $seed\ndone"
            ],
            "volumeMounts": [
              {
                "name": "results",
                "mountPath": "/results"
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "results",
            "persistentVolumeClaim": {
              "claimName": "results"
            }
          },
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "512Mi"
            }
          }
        ],
        "terminationGracePeriodSeconds": 1
      }
    },
    "ttlSecondsAfterFinished": 86400
  }
}
