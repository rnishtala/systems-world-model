{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "lab-budget",
        "namespace": "systems-world-model-lab"
      },
      "spec": {
        "hard": {
          "requests.cpu": "4",
          "limits.cpu": "4",
          "requests.memory": "6Gi",
          "limits.memory": "6Gi",
          "pods": "8",
          "persistentvolumeclaims": "1",
          "requests.storage": "10Gi"
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "swm-checkout",
        "namespace": "systems-world-model-lab"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "swm-component": "checkout"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "swm-component": "checkout"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "nodeSelector": {
              "kubernetes.io/hostname": "amd-halo"
            },
            "initContainers": [
              {
                "name": "unpack",
                "image": "python:3.11-slim",
                "command": [
                  "sh",
                  "-ec",
                  "tar xzf /source/app.tar.gz -C /app"
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "300m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "source",
                    "mountPath": "/source",
                    "readOnly": true
                  },
                  {
                    "name": "app",
                    "mountPath": "/app"
                  }
                ]
              }
            ],
            "containers": [
              {
                "name": "checkout",
                "image": "python:3.11-slim",
                "command": [
                  "python",
                  "/app/microservice/service.py"
                ],
                "env": [
                  {
                    "name": "SERVICE_ROLE",
                    "value": "checkout"
                  },
                  {
                    "name": "PYTHONDONTWRITEBYTECODE",
                    "value": "1"
                  },
                  {
                    "name": "PYTHONPATH",
                    "value": "/app/deps"
                  },
                  {
                    "name": "DOWNSTREAM",
                    "value": "http://swm-payment:8080"
                  }
                ],
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "300m",
                    "memory": "128Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "app",
                    "mountPath": "/app",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "source",
                "configMap": {
                  "name": "microservice-source-v1"
                }
              },
              {
                "name": "app",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "16Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
