{
  "on_http_request": [
    {
      "actions": [
        {
          "type": "oauth",
          "config": {
            "provider": "google"
          }
        }
      ]
    },
    {
      "expressions": [
        "!(actions.ngrok.oauth.identity.email in ['099.raj@gmail.com'])"
      ],
      "actions": [
        {
          "type": "deny",
          "config": {
            "status_code": 403
          }
        }
      ]
    },
    {
      "actions": [
        {
          "type": "remove-headers",
          "config": {
            "headers": [
              "x-swm-authenticated-email",
              "x-forwarded-user",
              "x-forwarded-email",
              "x-forwarded-groups",
              "x-forwarded-id-token",
              "authorization",
              "impersonate-user",
              "impersonate-group",
              "impersonate-uid"
            ]
          }
        },
        {
          "type": "add-headers",
          "config": {
            "headers": {
              "x-swm-authenticated-email": "${actions.ngrok.oauth.identity.email}"
            }
          }
        },
        {
          "type": "forward-internal",
          "config": {
            "url": "https://swm-headlamp.internal",
            "on_error": "halt"
          }
        }
      ]
    }
  ]
}
