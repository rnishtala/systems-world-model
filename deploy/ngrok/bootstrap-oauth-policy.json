{
  "on_http_request": [
    {
      "actions": [
        {
          "type": "oauth",
          "config": {
            "provider": "google"
          }
        }
      ]
    },
    {
      "expressions": [
        "!(actions.ngrok.oauth.identity.email in ['099.raj@gmail.com'])"
      ],
      "actions": [
        {
          "type": "deny",
          "config": {
            "status_code": 403
          }
        }
      ]
    }
  ]
}
