{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "swm-rcaeval-stage-v1",
    "namespace": "systems-world-model-lab",
    "labels": {
      "swm-role": "rcaeval-offline"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "nodeSelector": {
      "kubernetes.io/hostname": "amd-halo"
    },
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "fsGroup": 1000,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "experiment",
        "image": "python:3.11-slim",
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "256Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "768Mi"
          }
        },
        "env": [
          {
            "name": "PYTHONUNBUFFERED",
            "value": "1"
          },
          {
            "name": "PYTHONDONTWRITEBYTECODE",
            "value": "1"
          },
          {
            "name": "OMP_NUM_THREADS",
            "value": "1"
          },
          {
            "name": "OPENBLAS_NUM_THREADS",
            "value": "1"
          },
          {
            "name": "XLA_FLAGS",
            "value": "--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1"
          },
          {
            "name": "XDG_CACHE_HOME",
            "value": "/tmp/cache"
          }
        ],
        "command": [
          "sh",
          "-ec",
          "mkdir -p /results/rcaeval-v1; sleep 1800"
        ],
        "volumeMounts": [
          {
            "name": "results",
            "mountPath": "/results"
          },
          {
            "name": "tmp",
            "mountPath": "/tmp"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "results",
        "persistentVolumeClaim": {
          "claimName": "results"
        }
      },
      {
        "name": "tmp",
        "emptyDir": {
          "sizeLimit": "512Mi"
        }
      }
    ],
    "activeDeadlineSeconds": 1800
  }
}