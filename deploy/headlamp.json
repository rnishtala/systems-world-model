                "ipBlock": {
                  "cidr": "100.98.114.55/32"
                }
              }
            ],
            "ports": [
              {
                "port": 4466,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "egress": [
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "10.43.0.1/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "100.98.114.55/32"
                }
              }
            ],
            "ports": [
              {
                "port": 443,
                "protocol": "TCP"
              },
              {
                "port": 6443,
                "protocol": "TCP"
              }
            ]
          }
        ]
      }
