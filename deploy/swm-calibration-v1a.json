{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "swm-calibration-v1a",
    "namespace": "systems-world-model-lab"
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 7200,
    "template": {
      "metadata": {
        "labels": {
          "swm-role": "runner"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "nodeSelector": {
          "kubernetes.io/hostname": "amd-halo"
        },
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "experiment",
            "image": "python:3.11-slim",
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "500m",
                "memory": "512Mi"
              },
              "limits": {
                "cpu": "2400m",
                "memory": "4Gi"
              }
            },
            "env": [
              {
                "name": "PYTHONUNBUFFERED",
                "value": "1"
              },
              {
                "name": "PYTHONDONTWRITEBYTECODE",
                "value": "1"
              },
              {
                "name": "OMP_NUM_THREADS",
                "value": "1"
              },
              {
                "name": "OPENBLAS_NUM_THREADS",
                "value": "1"
              },
              {
                "name": "XLA_FLAGS",
                "value": "--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1"
              },
              {
                "name": "XDG_CACHE_HOME",
                "value": "/tmp/cache"
              }
            ],
            "command": [
              "sh",
              "-ec",
              "mkdir -p /results/swm-calibration-v1a-work\ntar xzf /source/app.tar.gz -C /results/swm-calibration-v1a-work\ncd /results/swm-calibration-v1a-work\nexport PYTHONPATH=/results/swm-calibration-v1a-work:/results/swm-calibration-v1a-work/deps:/results/work/upstream\nexport DREAMER_SOURCE=/results/work/upstream\n/results/venv/bin/python -m pytest tests/test_microservice.py -q && /results/venv/bin/python -m microservice.collect --out /results/micro-v1/calibration-v1a.jsonl --per-class 20 --seed 1200"
            ],
            "volumeMounts": [
              {
                "name": "source",
                "mountPath": "/source",
                "readOnly": true
              },
              {
                "name": "results",
                "mountPath": "/results"
              },
              {
                "name": "tmp",
                "mountPath": "/tmp"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "source",
            "configMap": {
              "name": "microservice-source-v2"
            }
          },
          {
            "name": "results",
            "persistentVolumeClaim": {
              "claimName": "results"
            }
          },
          {
            "name": "tmp",
            "emptyDir": {
              "sizeLimit": "512Mi"
            }
          }
        ]
      }
    },
    "ttlSecondsAfterFinished": 86400
  }
}
