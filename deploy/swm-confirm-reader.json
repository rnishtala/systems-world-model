{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "swm-confirm-reader",
    "namespace": "systems-world-model-lab"
  },
  "spec": {
    "automountServiceAccountToken": false,
    "restartPolicy": "Never",
    "activeDeadlineSeconds": 600,
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 1000,
      "runAsGroup": 1000,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "reader",
        "image": "python:3.11-slim",
        "command": [
          "sleep",
          "600"
        ],
        "resources": {
          "requests": {
            "cpu": "50m",
            "memory": "64Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "256Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "volumeMounts": [
          {
            "name": "results",
            "mountPath": "/results",
            "readOnly": true
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "results",
        "persistentVolumeClaim": {
          "claimName": "results",
          "readOnly": true
        }
      }
    ]
  }
}
