{
  "progressDeadlineSeconds": 600,
  "replicas": 1,
  "revisionHistoryLimit": 10,
  "selector": {
    "matchLabels": {
      "swm-component": "inference",
      "swm-role": "agent"
    }
  },
  "strategy": {
    "type": "Recreate"
  },
  "template": {
    "metadata": {
      "labels": {
        "swm-component": "inference",
        "swm-role": "agent"
      }
    },
    "spec": {
      "automountServiceAccountToken": false,
      "containers": [
        {
          "command": [
            "/results/venv/bin/python",
            "-m",
            "microservice.agent",
            "--root",
            "/models",
            "--controller",
            "inspect-latent",
            "--seeds",
            "23"
          ],
          "env": [
            {
              "name": "PYTHONPATH",
              "value": "/app:/app/deps:/results/work/upstream"
            },
            {
              "name": "DREAMER_SOURCE",
              "value": "/results/work/upstream"
            },
            {
              "name": "PYTHONDONTWRITEBYTECODE",
              "value": "1"
            },
            {
              "name": "PYTHONUNBUFFERED",
              "value": "1"
            },
            {
              "name": "OMP_NUM_THREADS",
              "value": "1"
            },
            {
              "name": "OPENBLAS_NUM_THREADS",
              "value": "1"
            },
            {
              "name": "XLA_FLAGS",
              "value": "--xla_cpu_multi_thread_eigen=false intra_op_parallelism_threads=1"
            },
            {
              "name": "XDG_CACHE_HOME",
              "value": "/tmp/cache"
            }
          ],
          "image": "python:3.11-slim",
          "imagePullPolicy": "IfNotPresent",
          "name": "agent",
          "readinessProbe": {
            "failureThreshold": 3,
            "httpGet": {
              "path": "/health",
              "port": 8088,
              "scheme": "HTTP"
            },
            "periodSeconds": 3,
            "successThreshold": 1,
            "timeoutSeconds": 1
          },
          "resources": {
            "limits": {
              "cpu": "2300m",
              "memory": "4Gi"
            },
            "requests": {
              "cpu": "300m",
              "memory": "512Mi"
            }
          },
          "securityContext": {
            "allowPrivilegeEscalation": false,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "readOnlyRootFilesystem": true
          },
          "terminationMessagePath": "/dev/termination-log",
          "terminationMessagePolicy": "File",
          "volumeMounts": [
            {
              "mountPath": "/app",
              "name": "app",
              "readOnly": true
            },
            {
              "mountPath": "/models",
              "name": "results",
              "readOnly": true,
              "subPath": "micro-latent-api-v1/serving"
            },
            {
              "mountPath": "/results/venv",
              "name": "results",
              "readOnly": true,
              "subPath": "venv"
            },
            {
              "mountPath": "/results/work/upstream",
              "name": "results",
              "readOnly": true,
              "subPath": "work/upstream"
            },
            {
              "mountPath": "/tmp",
              "name": "tmp"
            }
          ]
        }
      ],
      "dnsPolicy": "ClusterFirst",
      "initContainers": [
        {
          "command": [
            "sh",
            "-ec",
            "tar xzf /source/app.tar.gz -C /app"
          ],
          "image": "python:3.11-slim",
          "imagePullPolicy": "IfNotPresent",
          "name": "unpack",
          "resources": {
            "limits": {
              "cpu": "2300m",
              "memory": "4Gi"
            },
            "requests": {
              "cpu": "300m",
              "memory": "512Mi"
            }
          },
          "securityContext": {
            "allowPrivilegeEscalation": false,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "readOnlyRootFilesystem": true
          },
          "terminationMessagePath": "/dev/termination-log",
          "terminationMessagePolicy": "File",
          "volumeMounts": [
            {
              "mountPath": "/source",
              "name": "source",
              "readOnly": true
            },
            {
              "mountPath": "/app",
              "name": "app"
            }
          ]
        }
      ],
      "nodeSelector": {
        "kubernetes.io/hostname": "amd-halo"
      },
      "restartPolicy": "Always",
      "schedulerName": "default-scheduler",
      "securityContext": {
        "fsGroup": 1000,
        "runAsGroup": 1000,
        "runAsNonRoot": true,
        "runAsUser": 1000,
        "seccompProfile": {
          "type": "RuntimeDefault"
        }
      },
      "terminationGracePeriodSeconds": 30,
      "volumes": [
        {
          "configMap": {
            "defaultMode": 420,
            "name": "microservice-source-v20"
          },
          "name": "source"
        },
        {
          "emptyDir": {
            "sizeLimit": "32Mi"
          },
          "name": "app"
        },
        {
          "name": "results",
          "persistentVolumeClaim": {
            "claimName": "results",
            "readOnly": true
          }
        },
        {
          "emptyDir": {
            "sizeLimit": "512Mi"
          },
          "name": "tmp"
        }
      ]
    }
  }
}